{
  "name": "restrike-omc-web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "test": "pnpm -r test",
